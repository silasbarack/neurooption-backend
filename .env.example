# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=neurooption
DB_PASS=your_secure_password
DB_NAME=neurooption

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES=7d

# App
PORT=3001
NODE_ENV=development

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# CoinPayments
COINPAYMENTS_PUBLIC_KEY=...
COINPAYMENTS_PRIVATE_KEY=...

# NowPayments
NOWPAYMENTS_API_KEY=...

# Email (SMTP) - account creation, password reset and account deletion emails
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 (or 587), SMTP_PASS = 16-char App Password
# SendGrid: SMTP_HOST=smtp.sendgrid.net, SMTP_PORT=587, SMTP_USER=apikey, SMTP_PASS=<API key>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Optional: defaults to true when SMTP_PORT=465, otherwise false (STARTTLS)
SMTP_SECURE=
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="NeuroOption <your-account@gmail.com>"
# Public frontend URL used in email links (e.g. the password reset link)
APP_URL=http://localhost:3000
PASSWORD_RESET_CODE_TTL_MINUTES=15

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
