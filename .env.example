# Database / auth
DATABASE_URL=postgresql://user:password@host:5432/neurooption
JWT_SECRET=change-me
FRONTEND_URL=https://neurooption-frontend.onrender.com

# ---------------------------------------------------------------------------
# Email (welcome email + six-digit password recovery codes)
# The first configured option wins: BREVO_API_KEY, then RESEND_API_KEY, then SMTP.
#
# Render's FREE instance type blocks outbound SMTP ports 25/465/587, so on the
# free plan use an HTTPS email API (Brevo or Resend) instead of SMTP.
# ---------------------------------------------------------------------------

# Sender shown to users. Must be a verified sender/domain with your provider.
EMAIL_FROM="NeuroOption" <no-reply@yourdomain.com>

# Option 1: Brevo (free 300 emails/day; verify the sender email in Brevo)
BREVO_API_KEY=

# Option 2: Resend (requires a verified domain to email arbitrary users)
RESEND_API_KEY=

# Option 3: SMTP (works on paid Render instances, or on port 2525 if your provider supports it)
# Gmail: SMTP_SERVICE=gmail and SMTP_PASS = a 16-character Google App Password
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Optional: override the hosted logo used by the Brevo/Resend paths
# (SMTP emails embed the logo inline and don't need this)
EMAIL_LOGO_URL=
