# Database / auth
DATABASE_URL=postgresql://user:password@host:5432/neurooption
JWT_SECRET=change-me
FRONTEND_URL=https://neurooption-frontend.onrender.com

# ---------------------------------------------------------------------------
# Email (welcome email + six-digit password recovery codes)
# The first configured option wins: BREVO_API_KEY, then RESEND_API_KEY, then SMTP.
#
# Render's FREE instance type blocks outbound SMTP ports 25/465/587, so on the
# free plan use an HTTPS email API (Brevo or Resend) instead of SMTP.
# ---------------------------------------------------------------------------

# Sender shown to users. Must be a verified sender/domain with your provider.
EMAIL_FROM="NeuroOption" <no-reply@yourdomain.com>

# Option 1: Brevo (free 300 emails/day; verify the sender email in Brevo)
BREVO_API_KEY=

# Option 2: Resend (requires a verified domain to email arbitrary users)
RESEND_API_KEY=

# Option 3: SMTP (works on paid Render instances, or on port 2525 if your provider supports it)
# Gmail: SMTP_SERVICE=gmail and SMTP_PASS = a 16-character Google App Password
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Optional: override the hosted logo used by the Brevo/Resend paths
# (SMTP emails embed the logo inline and don't need this)
EMAIL_LOGO_URL=

# ---------------------------------------------------------------------------
# M-Pesa (Safaricom Daraja) - Lipa na M-Pesa Online / STK Push deposits
# Create an app at https://developer.safaricom.co.ke to get the key/secret.
# In sandbox, the public test shortcode 174379 and passkey are used
# automatically; production needs your own Paybill/Till and passkey.
# ---------------------------------------------------------------------------
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Production only (sandbox defaults are built in):
MPESA_SHORTCODE=
MPESA_PASSKEY=
# CustomerPayBillOnline (Paybill) or CustomerBuyGoodsOnline (Till)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# For Till numbers: the till number that receives the money
MPESA_PARTY_B=
MPESA_ACCOUNT_REFERENCE=NeuroOption
MPESA_MIN_AMOUNT=1
# Public HTTPS address of this backend, used to build the callback URL
BACKEND_PUBLIC_URL=https://neurooption-backend.onrender.com
# Optional: secret path segment for the callback (derived from JWT_SECRET if empty)
MPESA_CALLBACK_TOKEN=

# ---------------------------------------------------------------------------
# Dynamic payout engine (see docs/payout-engine.md). Defaults shown.
# ---------------------------------------------------------------------------
# PAYOUT_ENGINE_ENABLED=true
# PAYOUT_MIN_PERCENT=20
# PAYOUT_MAX_PERCENT=92
# PAYOUT_EVALUATION_INTERVAL_MS=60000
# PAYOUT_UPDATE_INTERVAL_MS=600000
# PAYOUT_MIN_HOLD_MS=600000
# PAYOUT_MAX_STEP_PERCENT=2
# PAYOUT_MAX_HOURLY_MOVEMENT_PERCENT=6
# PAYOUT_EMA_ALPHA=0.2
# PAYOUT_HYSTERESIS_PERCENT=0.75
# PAYOUT_MAX_RISK_REDUCTION_PERCENT=6
# PAYOUT_MAX_STABILITY_BONUS_PERCENT=3

# Monitored company mailbox for replies, including after account deletion.
# Configure frontend VITE_SUPPORT_EMAIL to the same monitored address.
EMAIL_REPLY_TO=
